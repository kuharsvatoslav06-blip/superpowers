{
  "name": "last-50-degrees",
  "version": "0.1.0",
  "private": true,
  "description": "«Последние 50 градусов» — вертикальный анимационный сериал (Remotion, 1080x1920, 30 FPS)",
  "scripts": {
    "prestudio": "node scripts/make-placeholder-audio.mjs --if-missing && node scripts/check-assets.mjs --quiet",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "node scripts/render.mjs",
    "render:all": "node scripts/render.mjs all",
    "still": "node scripts/render.mjs still",
    "audio:placeholders": "node scripts/make-placeholder-audio.mjs",
    "audio:check": "node scripts/check-assets.mjs",
    "docs": "node scripts/export-docs.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@remotion/bundler": "^4.0.290",
    "@remotion/cli": "4.0.290",
    "@remotion/renderer": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "esbuild": "0.25.0"
  }
}
